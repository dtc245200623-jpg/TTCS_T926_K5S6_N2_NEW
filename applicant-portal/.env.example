# Database
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=applicant_portal
MYSQL_USER=applicant_app
MYSQL_PASSWORD=change_this_db_password
DB_HOST=mysql
DB_PORT=3306

# App
PORT=5000
FRONTEND_ORIGIN=http://localhost
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
IP_HASH_SECRET=replace_with_a_long_random_secret
UPLOAD_DIR=/app/uploads

# phpMyAdmin
PMA_USER=applicant_app
PMA_PASSWORD=change_this_db_password

# Optional SMTP: leave blank to disable email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cổng ứng tuyển <no-reply@example.com>"
